# Server Port (Render sets this automatically)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/opsgrid?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random 64-char strings)
JWT_ACCESS_SECRET=your_long_random_jwt_access_secret_here
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma-separated for multiple origins, e.g. Vercel + Local dev)
CLIENT_ORIGIN=https://opsgrid.vercel.app,http://localhost:5173

# Cloudinary Storage for Field Proof Photos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Operations Intelligence
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
AI_CACHE_TTL_MINUTES=15